# Example environment variables - Copy this to .env and fill in your values
# DO NOT commit .env to git - it's already in .gitignore

# Google Gemini API Key (for scene description and OCR)
# Get it from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key (for advanced LLM features)
# Get it from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (optional, for alternative AI models)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API Key (optional, for weather features)
# Get it from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# Twilio Configuration (for SMS and WhatsApp messaging)
# Get it from: https://www.twilio.com/
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH=your_twilio_auth_token

# Email Configuration (optional, for email notifications)
# For Gmail: Use 16-character App Password
# https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Hardware Configuration
PYTHON_EXECUTABLE=/home/raspberry/VISIOASSIST/venv/bin/python
HOST_IP=192.168.1.94
EARPHONE_MAC=41:42:FF:54:11:F2
